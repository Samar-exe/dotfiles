{
// General Settings
  "layer": "top",
    "position": "top",
    "modules-left": [
    "hyprland/workspaces",
    ],
    "modules-center": [
      "clock"
    ],
    "modules-right": [
      "pulseaudio",
      "battery",
      "network",
      "group/fun",
      "custom/notifications",
      "custom/powermenu"
    ],


    // system stats
    "group/system": {
      "orientation": "horizontal",
      "modules": ["cpu", "memory"]
    },

    "custom/powermenu": {
      "format": "⏻",
      "tooltip": "Power Menu",
      "on-click": "~/.config/ml4w/scripts/wlogout.sh"
    },

    "hyprland/workspaces": {
      "format": "{icon}",
      "on-click": "activate",
      "format-icons": {
        "1": "静",
        "2": "光",
        "3": "夢",
        "4": "風",
        "5": "空"
      },
      "persistent-workspaces": {
        "*": [1, 2, 3, 4, 5]
      }
    },


    "group/fun":{
      "modules":["custom/ml4w-welcome",
      "custom/updates","memory","cpu", "power-profiles-daemon"],
      "orientation": "horizontal",
      "drawer":{
        "transition-duration": 500,
        "children-class": "not-power",
        "transition-left-to-right": false,
      }
    },

    "custom/notifications": {
      "format": "",
      "interval": 1,
      "on-click": "swaync-client -t -sw",
      "tooltip": false,
    },

    "custom/ml4w-welcome": {
    "on-click": "flatpak run com.ml4w.sidebar",
      "format": "",
    "tooltip-format": "Open Sidebar App"
    },

    "custom/updates": {
      "format": "  {}",
      "escape": true,
      "return-type": "json",
      "exec": "~/.config/ml4w/scripts/updates.sh",
      "interval": 1800,
      "on-click": "~/.config/ml4w/settings/installupdates.sh",
      "on-click-right": "~/.config/ml4w/settings/software.sh"
    },


    "battery": {
      "format": "{icon} {capacity}%",
      "format-icons": ["󱟢", "󱟣", "󱟤", "󱟥", "󱟦"],
      "states": {
        "critical": 15,
        "warning": 35,
        "good": 80
      },
      "interval":1
    },
    "pulseaudio": {
      "format": "{icon} {volume}%",
      "format-icons": {
        "headphone": "",
        "hands-free": "",
        "headset": "",
        "default": ["", ""]
      },
      "on-click": "pavucontrol"
    },
    "clock": {
      "format": "󰃭 {:%a %d %b  %H:%M}",
      "tooltip": false,
    },
    "network": {
      "format-wifi": "󰖩 {essid}",
      "format-ethernet": "󰈁 {ipaddr}",
      "format-disconnected": "󰖪 Disconnected",
      "on-click": "~/.config/ml4w/settings/networkmanager.sh",
    },

    "cpu": {
      "format": "󰍛 {usage}%",
      "tooltip": true
    },

    "memory": {
      "format": "󰾆 {used:0.1f}G",
      "tooltip": true
    },

  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": ""
    }
  },

}

